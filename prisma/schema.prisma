datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id       String @id @default(uuid())
    name     String
    username String @unique
    about    String
    pfp      String
    email    String @unique

    onboarded Boolean @default(false)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@map("users")
}
